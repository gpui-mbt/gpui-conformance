///|
test "drag preserves a directional anchor and ends without editing history" {
  input_reset()
  assert_true(input_insert("abcd"))
  assert_true(input_pointer(12.0, 50.0, false))
  assert_true(input_selecting())
  assert_true(input_pointer_move(48.0, 50.0))
  assert_eq(input_anchor(), 0)
  assert_eq(input_head(), 3)
  assert_eq(input_copy(), "abc")
  assert_true(input_pointer_move(24.0, 50.0))
  assert_eq(input_anchor(), 0)
  assert_eq(input_head(), 1)
  input_pointer_end()
  assert_false(input_selecting())
  assert_false(input_pointer_move(60.0, 50.0))
  assert_eq(input_head(), 1)
  assert_true(input_pointer(60.0, 50.0, false))
  assert_true(input_pointer_move(24.0, 50.0))
  assert_eq(input_anchor(), 4)
  assert_eq(input_head(), 1)
  input_pointer_end()
  assert_true(input_pointer(36.0, 50.0, true))
  assert_eq(input_anchor(), 4)
  assert_eq(input_head(), 2)
  assert_true(input_pointer_move(-50.0, 50.0))
  assert_eq(input_anchor(), 4)
  assert_eq(input_head(), 0)
  input_pointer_end()
  assert_true(input_key("z", false, true, false))
  assert_eq(input_text(), "")
}

///|
test "drag clamps to field bounds and scalar-safe UTF16 positions" {
  input_reset()
  assert_true(input_insert("a😀漢"))
  assert_false(input_pointer(12.0, 100.0, false))
  assert_false(input_selecting())
  assert_false(input_pointer(0.0 / 0.0, 50.0, false))
  assert_true(input_pointer(24.0, 50.0, false))
  assert_true(input_pointer_move(36.0, 50.0))
  assert_eq(input_anchor(), 1)
  assert_eq(input_head(), 3)
  assert_eq(input_copy(), "😀")
  assert_false(input_pointer_move(1.0 / 0.0, 50.0))
  assert_eq(input_head(), 3)
  assert_true(input_pointer_move(400.0, 50.0))
  assert_eq(input_anchor(), 1)
  assert_eq(input_head(), 4)
  assert_eq(input_copy(), "😀漢")
  assert_true(input_pointer_move(-100.0, 50.0))
  assert_eq(input_anchor(), 1)
  assert_eq(input_head(), 0)
  input_reset()
  assert_false(input_selecting())
  assert_false(input_pointer_move(48.0, 50.0))
}

///|
test "drag hit testing accounts for horizontal scroll and preserves composition" {
  input_reset()
  assert_true(input_insert("abcdefghijklmnopqrstuvwxyz0123456789"))
  assert_true(input_scroll_offset() > 0.0)
  assert_true(input_pointer(288.0, 50.0, false))
  assert_eq(input_anchor(), 36)
  assert_true(input_pointer_move(264.0, 50.0))
  assert_eq(input_anchor(), 36)
  assert_eq(input_head(), 34)
  assert_eq(input_copy(), "89")
  input_pointer_end()
  assert_true(input_preedit("かな", 2, 2))
  assert_false(input_pointer(12.0, 50.0, false))
  assert_false(input_selecting())
  assert_true(input_composing())
  assert_true(input_finish("", false))
  assert_eq(input_text(), "abcdefghijklmnopqrstuvwxyz0123456789")
  assert_eq(input_anchor(), 36)
  assert_eq(input_head(), 34)
}

///|
test "captured drag reaches offscreen text and resolves above or below the line" {
  input_reset()
  assert_true(input_insert("abcdefghijklmnopqrstuvwxyz0123456789"))
  assert_true(input_key("Home", false, false, false))
  assert_eq(input_scroll_offset(), 0.0)
  assert_true(input_pointer(12.0, 50.0, false))
  assert_true(input_pointer_move(600.0, 50.0))
  assert_eq(input_anchor(), 0)
  assert_eq(input_head(), 36)
  assert_true(input_scroll_offset() > 0.0)
  input_pointer_end()
  assert_true(input_pointer(288.0, 50.0, false))
  assert_true(input_pointer_move(-300.0, 50.0))
  assert_eq(input_anchor(), 36)
  assert_eq(input_head(), 0)
  assert_eq(input_scroll_offset(), 0.0)
  input_pointer_end()
  assert_true(input_pointer(48.0, 50.0, false))
  assert_true(input_pointer_move(48.0, 120.0))
  assert_eq(input_anchor(), 3)
  assert_eq(input_head(), 36)
  assert_true(input_pointer_move(48.0, 10.0))
  assert_eq(input_anchor(), 3)
  assert_eq(input_head(), 0)
  input_pointer_end()
}


///|
test "plain clicks in top and bottom field padding stay collapsed on release" {
  input_reset()
  assert_true(input_insert("abcdef"))
  for y in [35.0, 70.0] {
    assert_true(input_pointer(36.0, y, false))
    assert_eq(input_anchor(), 2)
    assert_eq(input_head(), 2)
    assert_true(input_pointer_move(36.0, y))
    assert_eq(input_anchor(), 2)
    assert_eq(input_head(), 2)
    input_pointer_end()
  }
}
